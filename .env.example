# UrbanPulse environment configuration
APP_NAME=UrbanPulse
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=urbanpulse-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with PostGIS / TimescaleDB, or SQLite fallback)
DATABASE_URL=sqlite:///./urbanpulse.db
POSTGRES_USER=urbanpulse
POSTGRES_PASSWORD=urbanpulse_secret
POSTGRES_DB=urbanpulse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# MinIO / Object Store
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=urbanpulse-artifacts
MINIO_SECURE=False

# MQTT (Sensor Streams)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSORS=urbanpulse/sensors/#

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
